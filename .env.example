# ─── nota / enhance — environment variables ───────────────────────────────
# Copia questo file in `.env.local` per lo sviluppo, e replicalo in
# Project Settings → Environment Variables su Vercel per il deploy.

# ── AI providers ──────────────────────────────────────────────────────────
# OpenRouter (Enhance + Ask AI). Necessaria.
OPENROUTER_API_KEY=
# (opzionale) override di model / referer / sito
OPENROUTER_MODEL=
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=
OPENROUTER_PROVIDER=

# Groq Whisper (trascrizione audio). Necessaria se usi Registra/Importa.
GROQ_API_KEY=
GROQ_TRANSCRIBE_MODEL=

# ── Auth ──────────────────────────────────────────────────────────────────
# Stringa randomica usata per firmare i cookie di sessione (HMAC).
# Generala con: `openssl rand -base64 48`. MIN 16 caratteri.
# In production il server rifiuta di partire se è mancante o troppo corta.
AUTH_SECRET=

# ── Google OAuth (opzionale) ──────────────────────────────────────────────
# Necessari per il pulsante "Continua con Google" sulla pagina di login.
# Se mancano, il pulsante restituisce un errore "OAuth non configurato"
# ma la registrazione email/password continua a funzionare normalmente.
#
# Setup:
#   1. https://console.cloud.google.com → New Project (o esistente)
#   2. APIs & Services → Credentials → "Create Credentials" → "OAuth client ID"
#   3. Application type: "Web application"
#   4. Authorized redirect URIs: aggiungi
#        https://<tuo-dominio>/api/auth/google/callback
#        http://localhost:3000/api/auth/google/callback   (per dev)
#   5. Copia Client ID e Client Secret qui sotto.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opzionale — se omessa, il server costruisce il redirect dal Host header.
# Utile solo se il deploy gira dietro un proxy che maschera l'origine.
GOOGLE_REDIRECT_URI=

# ── Database (Postgres / Neon) — store principale per account + note ──────
# È la fonte di verità per profili utente, note (una riga per nota,
# sincronizzate tra dispositivi) e le colonne abbonamento/crediti.
#
# Setup su Vercel: Storage → Create Database → Postgres (Neon). Vercel
# inietta in automatico DATABASE_URL / POSTGRES_URL nel progetto.
# In alternativa, un Neon standalone (https://neon.tech) → copia la
# connection string qui sotto.
#
# Lo schema viene creato in automatico al primo avvio (CREATE TABLE IF NOT
# EXISTS), non serve eseguire migrazioni a mano.
#
# Se questa è VUOTA, l'app ricade su Vercel KV (sotto) per credenziali e
# note, esattamente come prima — utile finché non provisioni il DB. Una
# volta impostata, account e note in KV vengono migrati su Postgres al
# primo accesso di ciascun utente (migrazione lazy, nessuna perdita dati).
#
# I crediti per piano e il costo di ogni operazione vivono in due tabelle
# (`plans` e `credit_costs`) seedate con valori di default al primo avvio.
# Per cambiarli SENZA redeploy:
#   UPDATE plans SET monthly_credits = 200 WHERE id = 'pro';
#   UPDATE credit_costs SET cost = 2 WHERE operation = 'enhance';
#   INSERT INTO plans (id, display_name, monthly_credits, position)
#     VALUES ('plus', 'Plus', 150, 2);
# Le modifiche vengono raccolte dall'app entro ~60 s (cache in memoria).
DATABASE_URL=

# ── Stripe (opzionale, abilita il checkout) ────────────────────────────────
# Necessari per "Passa a Pro" / "Gestisci abbonamento" sulla pagina /account.
# Senza, l'app gira regolarmente in modalità free-only.
#
# Setup:
#   1. https://dashboard.stripe.com → crea Product → Price (mensile)
#      ripeti per ogni piano (Pro, Plus, …)
#   2. Per ogni Price ID generato, esegui in DB:
#        UPDATE plans SET stripe_price_id = 'price_xyz' WHERE id = 'pro';
#   3. Webhook: Stripe → Developers → Webhooks → Add endpoint
#        URL:    https://<tuo-dominio>/api/billing/webhook
#        Events: checkout.session.completed, customer.subscription.created,
#                customer.subscription.updated, customer.subscription.deleted,
#                invoice.paid, invoice.payment_failed
#        Copia il "Signing secret" qui sotto.
#   4. Customer portal: Settings → Billing → Customer portal → attivalo.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Storage credenziali/note legacy (Vercel KV) — fallback ────────────────
# Usato solo quando DATABASE_URL è vuota. In dev possono restare vuote:
# l'app usa file JSON locali (gitignored). Su Vercel un Vercel KV / Upstash
# store popola queste in automatico.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Alternativa Upstash diretta (Vercel Marketplace usa già questi nomi).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Storage audio (Vercel Blob) ───────────────────────────────────────────
# Necessario in production per importare file audio > 4.5 MB (limite hard
# del body delle serverless function su Vercel). Provisionare uno store
# "Blob" dal dashboard Vercel popola in automatico questa env. In dev può
# restare vuota: il client carica direttamente via FormData.
BLOB_READ_WRITE_TOKEN=
